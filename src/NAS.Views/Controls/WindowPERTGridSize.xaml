<Window x:Class="NAS.Views.Controls.WindowPERTGridSize" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resx="clr-namespace:NAS.Resources;assembly=NAS.Resources" xmlns:toolkit="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:viewmodels="clr-namespace:NAS.ViewModels;assembly=NAS.ViewModels"
        Title="{x:Static resx:NASResources.Size}"
        Width="300" Height="120"
        d:DataContext="{d:DesignInstance Type=viewmodels:PERTGridSizeViewModel}"
        Icon="pack://application:,,,/NAS.Views;component/Images/Stones.ico" WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Row="1" Margin="5"
               Text="{x:Static resx:NASResources.Size}" />
    <toolkit:DoubleUpDown Grid.Row="1" Grid.Column="1" Margin="2"
                          IsEnabled="{Binding AutoSize, Converter={StaticResource NegationConverter}}"
                          Maximum="1000" Minimum="10"
                          Value="{Binding Size}" />
    <CheckBox Grid.Row="1" Grid.Column="2" Margin="5"
              Content="{x:Static resx:NASResources.Auto}"
              IsChecked="{Binding AutoSize}" />
    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="2"
                HorizontalAlignment="Right" Orientation="Horizontal">
      <Button MinWidth="75" Click="buttonOK_Click"
              Content="{x:Static resx:NASResources.OK}" />
      <Button MinWidth="75" Margin="2,0,0,0" Click="buttonCancel_Click"
              Content="{x:Static resx:NASResources.Cancel}" />
    </StackPanel>
  </Grid>
</Window>